[[ -o interactive ]] || return

# Login shells already ran .zprofile. Terminals that start non-login shells
# still need it, but nested shells inherit its result and must not reorder PATH.
[[ -o login || -n "${DOTFILES_ZPROFILE_LOADED:-}" ]] || source "${ZDOTDIR}/.zprofile"

typeset -U path PATH fpath

typeset -ga ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd completion history)

# Not exported: a child bash would otherwise write into this history file.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
typeset +x HISTFILE HISTSIZE SAVEHIST
mkdir -p "${HISTFILE:h}" "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

setopt auto_cd
setopt auto_pushd
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt pushd_ignore_dups
setopt share_history

unsetopt beep
unsetopt flow_control

alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'

alias -- -='cd -'
alias vim='nvim'
alias history='history 1'
alias ~~='~'

if (( $+commands[lsd] )); then
	alias ls='lsd'
	alias l='lsd -lah'
	alias ll='lsd -lh'
	alias la='lsd -lAh'
elif (( $+commands[eza] )); then
	alias ls='eza --group-directories-first'
	alias l='eza -lah --group-directories-first'
	alias ll='eza -lh --group-directories-first'
	alias la='eza -lAh --group-directories-first'
else
	alias l='ls -lah'
	alias ll='ls -lh'
	alias la='ls -lAh'
fi

[[ -r "${ZDOTDIR}/local.zsh" ]] && source "${ZDOTDIR}/local.zsh"

zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"
zstyle ':completion:*' complete true
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' file-sort modification
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*:cd:*' tag-order local-directories directory-stack path-directories

autoload -Uz compinit

bundled_zsh_data="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles"

antidote_file=''
for candidate in \
	"$bundled_zsh_data/antidote/antidote.zsh" \
	"${HOMEBREW_PREFIX:-}/opt/antidote/share/antidote/antidote.zsh" \
	"/opt/homebrew/opt/antidote/share/antidote/antidote.zsh" \
	"/usr/local/opt/antidote/share/antidote/antidote.zsh" \
	"/home/linuxbrew/.linuxbrew/opt/antidote/share/antidote/antidote.zsh" \
	"/usr/share/zsh-antidote/antidote.zsh" \
	"/usr/share/antidote/antidote.zsh"
do
	if [[ -r "$candidate" ]]; then
		antidote_file="$candidate"
		break
	fi
done

if [[ -n "$antidote_file" ]]; then
	source "$antidote_file"

	# The offline bundle ships plugin clones here so antidote never needs a network.
	[[ -d "$bundled_zsh_data/antidote-home" ]] && export ANTIDOTE_HOME="$bundled_zsh_data/antidote-home"

	antidote_bundle() {
		local source_file="$1"
		local bundle_file="$2"
		local temp_file="${bundle_file}.$$"

		[[ -f "$source_file" ]] || return 0
		# Publish only a complete bundle: a failed clone must not leave an empty
		# file that looks newer than its source and disables plugins for good.
		if [[ ! -s "$bundle_file" || ! "$bundle_file" -nt "$source_file" ]]; then
			if antidote bundle <"$source_file" >|"$temp_file" && [[ -s "$temp_file" ]]; then
				mv -f "$temp_file" "$bundle_file"
			else
				rm -f "$temp_file"
				print -u2 "warning: could not update zsh plugins from ${source_file:t}; will retry next shell"
			fi
		fi
		[[ -r "$bundle_file" ]] && source "$bundle_file"
	}

	antidote_bundle "${ZDOTDIR}/plugins.txt" "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/plugins.zsh"
else
	print -u2 'warning: antidote was not found; zsh plugins were not loaded'
fi

compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

if (( $+functions[antidote_bundle] )); then
	antidote_bundle "${ZDOTDIR}/plugins-late.txt" "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/plugins-late.zsh"
fi

(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
# Before atuin, so Ctrl-R stays with atuin; fzf adds Ctrl-T, Alt-C, and **<Tab>.
(( $+commands[fzf] )) && source <(fzf --zsh 2>/dev/null)
(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow)"

bindkey -e

(( $+commands[starship] )) && eval "$(starship init zsh)"

[[ "${TERM_PROGRAM:-}" == iTerm.app && -r "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"
