for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
	if [[ -x "$brew_bin" ]]; then
		eval "$("$brew_bin" shellenv)"
		break
	fi
done

[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"
[[ -r "$HOME/.swiftly/env.sh" ]] && source "$HOME/.swiftly/env.sh"

if [[ -z "${PNPM_HOME:-}" ]]; then
	if [[ "$OSTYPE" == darwin* ]]; then
		export PNPM_HOME="$HOME/Library/pnpm"
	else
		export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
	fi
fi

# Keep user-level tools, including uv-managed Python, rustup, OrbStack's CLI
# shims, and pnpm-managed executables, ahead of package-manager binaries. This
# lives here, not in .zshrc, so `zsh -lc` resolves the same tools as a terminal.
typeset -U path PATH
path=(
	"$HOME/.local/bin"
	"$HOME/bin"
	"${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin"
	"$HOME/.cargo/bin"
	"$HOME/go/bin"
	"$HOME/.bun/bin"
	"$HOME/.orbstack/bin"
	"$PNPM_HOME/bin"
	"$PNPM_HOME"
	$path
)
path=(${^path}(N-/))

# PATH is ready, so this can tell whether bat is really installed.
if (( $+commands[bat] )); then
	export PAGER="${PAGER:-bat --style=plain}"
	if (( $+commands[col] )); then
		export MANPAGER="${MANPAGER:-sh -c 'col -bx | bat --language=man --style=plain'}"
		export MANROFFOPT="${MANROFFOPT:--c}"
	fi
fi

export DOTFILES_ZPROFILE_LOADED=1
